#!/bin/bash

#SBATCH -t 20
#SBATCH -p q_student
#SBATCH -c 32
#SBATCH --job-name=julia_cpu_bench

# Keep your environment sourcing
. vars_in.sh

BINARY="../src/juliaset_cpu"

# Ensure the output directory exists
mkdir -p ../output/cpu_vs_gpu

for SIZE in 1000 2000 4000 8000 16000
do 
  echo "Benchmarking CPU resolution ${SIZE}x${SIZE}..."
  # Piping directly into the scaling results file 
  $BINARY -r $SIZE $SIZE -n 5 >> ../output/cpu_vs_gpu/benchmark_cpu_scaling.txt
done

